config tachyon 'settings'
	option default_route 'direct'
	option auto_update_lists '1'
	option list_update_interval '86400'
	option log_level 'info'

config section 'Direct_RU'
	option type 'section'
	option name 'Direct_RU'
	option enabled '1'
	option priority '1'
	option action 'bypass'
	list community_lists 'ru_whitelist'
	list community_lists 'ru_only_inside'

config section 'Desync_YouTube'
	option type 'section'
	option name 'Desync_YouTube'
	option enabled '1'
	option priority '10'
	option type 'desync'
	option desync_preset 'youtube'
	list community_lists 'youtube'

config section 'Desync_Telegram'
	option type 'section'
	option name 'Desync_Telegram'
	option enabled '1'
	option priority '11'
	option type 'desync'
	option desync_preset 'auto'
	list community_lists 'telegram'

config section 'VPN_Proxy'
	option type 'section'
	option name 'VPN_Proxy'
	option enabled '1'
	option priority '20'
	option type 'connection'
	option outbound 'vps_vless'
	list community_lists 'discord'
	list community_lists 'telegram'

config outbound 'vps_vless'
	option type 'vless'
	option address '138.124.112.202'
	option port '443'
	option uuid '14297db4-54b6-4d20-bda5-fdeb997f6c0a'
	option flow 'xtls-rprx-vision'
	option tls '1'
	option reality '1'
	option reality_public_key 'DjkuH9C_ZuXUqHxkkcZQqsMJyuh_F_5GADBTrnoodxc'
	option reality_short_id '75de117772021de3'
	option server_name 'www.microsoft.com'
	option fingerprint 'chrome'

config balancer 'bal_vps_vless'
	option type 'urltest'
	list outbound 'vps_vless'
	option interval '60'
	option url 'https://www.gstatic.com/generate_204'
